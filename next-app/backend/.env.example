# Copy to .env and fill in your MySQL details
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=kirana
DB_USER=root
DB_PASSWORD=

# Store-owner Google sign-in (optional); leave blank to disable the button
GOOGLE_CLIENT_ID=

# true = OTP code is returned in the API response for local testing
OTP_DEV_MODE=true

# Base URL used to build absolute image URLs for uploads
PUBLIC_URL=http://localhost:4000
